###############################################################################
# CerradoPDF — Sistema Institucional de Manipulação de Documentos PDF (UniCerrado)
# Exemplo de configuração para PRODUÇÃO no servidor institucional.
# Copie para `.env` e ajuste. NÃO versionar o `.env` real (contém segredos).
#
# As variáveis abaixo seguem o mapeamento do settings.yml:
#   security.enableLogin            -> SECURITY_ENABLELOGIN
#   security.allowedEmailDomains    -> SECURITY_ALLOWEDEMAILDOMAINS
#   system.backendUrl               -> SYSTEM_BACKENDURL
#   etc.
###############################################################################

# ---------- Identidade ----------
UI_APPNAME=CerradoPDF
UI_APPNAMENAVBAR=CerradoPDF
UI_HOMEDESCRIPTION=Sistema Institucional de Manipulação de Documentos PDF da UniCerrado
SYSTEM_DEFAULTLOCALE=pt-BR

# ---------- Servidor / URL pública ----------
# URL externa da aplicação (obrigatória para OAuth2 atrás de proxy reverso HTTPS)
SYSTEM_BACKENDURL=https://cerradopdf.unicerrado.edu.br
SYSTEM_FRONTENDURL=https://cerradopdf.unicerrado.edu.br
# Context path, se servir sob um subcaminho (ex.: /pdf). Normalmente vazio.
SYSTEM_ROOTURIPATH=
# Porta interna do container
SERVER_PORT=8080

# ---------- Autenticação ----------
# Login obrigatório antes de acessar as ferramentas
SECURITY_ENABLELOGIN=true
# 'oauth2' = somente SSO (recomendado). 'all' = SSO + usuário/senha (mantém o
# login local do admin para contingência).
SECURITY_LOGINMETHOD=oauth2
# Allowlist de domínios institucionais (separados por vírgula).
# Alunos: alunos.unicerrado.edu.br. Acrescente os demais domínios de
# professores/servidores confirmados pela TI da UniCerrado.
SECURITY_ALLOWEDEMAILDOMAINS=alunos.unicerrado.edu.br
# Auto-cria a conta local no primeiro login institucional válido
SECURITY_OAUTH2_AUTOCREATEUSER=true
# Redireciona direto para o provedor quando for o único configurado
SECURITY_SSOAUTOLOGIN=false

# ---------- OAuth2 / Google Workspace ----------
# Crie as credenciais no Google Cloud Console (OAuth client ID, tipo Web).
# Redirect URI autorizado: ${SYSTEM_BACKENDURL}/login/oauth2/code/google
SECURITY_OAUTH2_ENABLED=true
SECURITY_OAUTH2_PROVIDER=google
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTID=
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTSECRET=
SECURITY_OAUTH2_CLIENT_GOOGLE_SCOPES=email, profile
SECURITY_OAUTH2_USEASUSERNAME=email

# ---------- Conta administrativa inicial ----------
# Criada somente no primeiro boot (trocar a senha após o primeiro acesso).
# Observação: com a allowlist ativa, use usuário simples (sem '@') ou um e-mail
# de domínio autorizado.
SECURITY_INITIALLOGIN_USERNAME=admin
SECURITY_INITIALLOGIN_PASSWORD=trocar-esta-senha

# ---------- Uploads / arquivos temporários ----------
# Limite de upload (MB ou formato Spring: 100MB)
SYSTEM_FILEUPLOADLIMIT=100MB
# Diretório temporário dentro do container (limpeza automática já é feita pelo
# sistema de gerenciamento de arquivos temporários do CerradoPDF)
# SYSTEM_CUSTOMPATHS_* / volumes no compose controlam a persistência real.

# ---------- Sessões / cookies (produção HTTPS) ----------
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ---------- CORS (restritivo em produção) ----------
SYSTEM_CORSALLOWEDORIGINS=https://cerradopdf.unicerrado.edu.br

# ---------- Privacidade / telemetria ----------
SYSTEM_ENABLEANALYTICS=false
SYSTEM_ENABLEPOSTHOG=false
SYSTEM_ENABLESCARF=false
SYSTEM_GOOGLEVISIBILITY=false
SHOW_SURVEY=false
METRICS_ENABLED=false
# Auditoria interna (não registra conteúdo dos PDFs; apenas metadados de evento)
PREMIUM_ENTERPRISEFEATURES_AUDIT_ENABLED=true
PREMIUM_ENTERPRISEFEATURES_AUDIT_LEVEL=1

# ---------- Misc ----------
DOCKER_ENABLE_SECURITY=true
# Fuso horário do container
TZ=America/Sao_Paulo
