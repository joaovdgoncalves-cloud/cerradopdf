# oauth-local.env.example — copie para oauth-local.env e preencha.
# oauth-local.env fica fora do Git (.gitignore cobre .env*).
#
# Sem esse arquivo, o backend sobe SEM login (modo livre).
# Com ele, o login Google ativa automaticamente.

SECURITY_LOGINMETHOD=oauth2
SECURITY_OAUTH2_ENABLED=true
SECURITY_OAUTH2_PROVIDER=google
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTID=SEU_CLIENT_ID.apps.googleusercontent.com
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTSECRET=SEU_CLIENT_SECRET
SECURITY_OAUTH2_USEASUSERNAME=email
SECURITY_OAUTH2_AUTOCREATEUSER=true
SECURITY_ALLOWEDEMAILDOMAINS=alunos.unicerrado.edu.br,unicerrado.edu.br
