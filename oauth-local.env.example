# oauth-local.env.example
# Copie este arquivo para "oauth-local.env" para ativar o login Google
# no ambiente local. O arquivo oauth-local.env fica fora do Git
# (.gitignore cobre *-local.env) — nunca suba credenciais reais.

# Com o arquivo presente, o start-backend-local.bat ja liga
# SECURITY_ENABLELOGIN=true automaticamente. Para forcar desligado:
# SECURITY_ENABLELOGIN=false

# Client OAuth do Google (crie em console.cloud.google.com):
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTID=SEU_CLIENT_ID.apps.googleusercontent.com
SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTSECRET=SEU_CLIENT_SECRET

# Dominios permitidos (apenas contas institucionais):
# SECURITY_ALLOWEDEMAILDOMAINS=alunos.unicerrado.edu.br,unicerrado.edu.br
