# oauth-local.env.example — OPCIONAL.
# O app ja sobe COM login Google por padrao (credenciais embutidas no .bat).
# Copie para oauth-local.env apenas para SOBRESCREVER alguma variavel
# (ex.: trocar o client do Google ou DESLIGAR o login).
# oauth-local.env fica fora do Git (.gitignore cobre *-local.env).

# Desligar o login (modo livre, sem Google):
# SECURITY_ENABLELOGIN=false

# Trocar o client OAuth do Google:
# SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTID=SEU_CLIENT_ID.apps.googleusercontent.com
# SECURITY_OAUTH2_CLIENT_GOOGLE_CLIENTSECRET=SEU_CLIENT_SECRET

# Trocar os dominios permitidos:
# SECURITY_ALLOWEDEMAILDOMAINS=alunos.unicerrado.edu.br,unicerrado.edu.br
